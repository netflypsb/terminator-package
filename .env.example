# Terminator Package — Environment Variables
# Copy this file to .env and fill in the values you need.
# All variables are OPTIONAL — only configure the services you want to use.

# ============================================
# Communication Channels
# ============================================

# Telegram Bot Token (from @BotFather)
# TELEGRAM_BOT_TOKEN=

# Telegram Chat ID (your personal chat or group)
# TELEGRAM_CHAT_ID=

# Discord Bot Token
# DISCORD_BOT_TOKEN=

# Discord Channel ID
# DISCORD_CHANNEL_ID=

# Slack Bot Token
# SLACK_BOT_TOKEN=

# Slack Channel ID
# SLACK_CHANNEL_ID=

# ============================================
# Email (SMTP for sending, IMAP for reading)
# ============================================

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASS=

# ============================================
# Browser / Search
# ============================================

# Optional: API key for enhanced web search
# SEARCH_API_KEY=

# ============================================
# Terminator Settings
# ============================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

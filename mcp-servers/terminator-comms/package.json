{
  "name": "terminator-comms",
  "version": "0.1.0",
  "description": "Multi-channel communications MCP server for Terminator Package",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --watch",
